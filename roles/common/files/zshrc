# Managed by the Ansible common role (roles/common/files/zshrc).
# Shared, portable base config. Put machine- or work-specific settings in
# ~/.zshrc.local — it is sourced at the end and is never tracked in the repo.

# If you come from bash you might have to change your $PATH.
export PATH=$HOME/.local/bin:$PATH

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Theme. See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="bira"

# Which plugins to load. Standard plugins live in $ZSH/plugins/.
# Add wisely, as too many plugins slow down shell startup.
plugins=(git)

# Check for Oh My Zsh updates every 3 months (frequency is in days).
zstyle ':omz:update' frequency 90

source $ZSH/oh-my-zsh.sh

# Preferred editor for local and remote sessions.
export EDITOR=vim

# Proton Pass SSH agent, for tools that only read SSH_AUTH_SOCK (ssh-add, git
# commit signing via ssh-keygen). ssh itself is pointed at it in ~/.ssh/config.
[ -S ~/.ssh/proton-pass-ssh-agent.sock ] && export SSH_AUTH_SOCK=~/.ssh/proton-pass-ssh-agent.sock

# Shared aliases (managed by the Ansible common role).
[ -f ~/.zsh_aliases ] && source ~/.zsh_aliases

# Machine-local config: aliases, env vars, completions, and anything specific
# to this machine. Not tracked in the dotfiles repo. See ~/.zshrc.local.
[ -f ~/.zshrc.local ] && source ~/.zshrc.local
